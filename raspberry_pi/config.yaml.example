# Copy to config.yaml and set your MQTT password (or use MQTT_PASSWORD env var)
serial:
  port: /dev/serial0
  baud: 9600
  timeout: 1.0

mqtt:
  host: 127.0.0.1
  port: 8883
  topic: medical_kit/vitals
  qos: 1
  ca_cert: /etc/mosquitto/certs/ca.crt
  username: medical_gateway
  password: changeme

logging:
  level: INFO
  file: /var/log/medical_gateway.log
